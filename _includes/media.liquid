<div class="media-section">
  {% if site.media != blank %}
    {% assign media_size = site.media | size %}
    <div
      class="table-responsive"
      {% if include.limit and page.announcements.scrollable and media_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% assign media = site.media %}
        {% if include.limit and page.announcements.limit %}
          {% assign media_limit = page.announcements.limit %}
        {% else %}
          {% assign media_limit = media_size %}
        {% endif %}
        {% for item in media limit: media_limit %}
          <tr>
            <th scope="row" style="width: 20%">
              {% if item.icon %}
                {% assign icon_image_path = item.icon | prepend: 'assets/img/' %}
                <img
                  class="media-icon"
                  src="{{ icon_image_path }}"
                  {% if item.icon_bg %}
                    style="background-color: {{ item.icon_bg }};"
                  {% endif %}
                >
              {% else %}
                {{ item.date | date: '%b %d, %Y' }}
              {% endif %}
            </th>
            <td style="vertical-align: middle;">
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="media-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% endif %}
  <h4>EMNLP 2023 Outstanding Paper Award</h4>
  <div class="awards-container">
    <image class="awards-img" src="assets/img/awards_1.jpg">
    <image class="awards-img" src="assets/img/awards_2.jpg">
  </div>
</div>
