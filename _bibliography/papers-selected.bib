@misc{Suresh2024Factify5WQA,
 abstract = {Researchers have found that fake news spreads much faster than real news, especially on platforms used widely by younger demographics. Manual fact-checking is labor-intensive and can't match the pace of misinformation. The Factify5WQA shared task addresses this by promoting an automated, explainable fact-verification pipeline where claims are paired with supporting documents and evaluated through 5W-based (Who, What, When, Where, Why) question answering. Answers are evaluated using BLEU followed by accuracy metrics. With a ~35% improvement over random baseline, the best-performing system achieved 69.56% accuracy.},
 archiveprefix = {arXiv},
 author = {Suryavardan Suresh and Anku Rani and Parth Patwa and Aishwarya Reganti and Vinija Jain and Aman Chadha and Amitava Das and Amit Sheth and Asif Ekbal},
 eprint = {2410.04236},
 primaryclass = {cs.CL},
 title = {Overview of Factify5WQA: Fact Verification through 5W Question-Answering},
 url = {https://arxiv.org/abs/2410.04236},
 year = {2024}
}

@misc{Rawte2024PausePrompting,
 abstract = {Hallucination remains a critical weakness of large language models (LLMs). We propose the “Sorry, Come Again” (SCA) prompting framework, which combines optimal paraphrasing and strategic insertion of [PAUSE] tokens to slow down generation and promote deeper processing. We analyze linguistic traits such as readability, formality, and concreteness across prompts on 21 LLMs, and show that low clarity leads to more hallucinations. We then identify optimal paraphrases using integrated gradients, and fine-tune models with [PAUSE]-injected inputs. This dual approach notably improves coherence and factuality in generated outputs.},
 archiveprefix = {arXiv},
 author = {Vipula Rawte and S. M. T. Tonmoy and S. M. Zaman and Prachi Priya and Aman Chadha and Amit P. Sheth and Amitava Das},
 eprint = {2403.18976},
 primaryclass = {cs.CL},
 title = {“Sorry, Come Again?” Prompting - Enhancing Comprehension and Diminishing Hallucination with [PAUSE]-Injected Optimal Paraphrasing},
 url = {https://arxiv.org/abs/2403.18976},
 year = {2024}
}

@misc{Rani2023SEPSIS,
 abbr = {ACL 2025},
 abstract = {Deception is the intentional practice of twisting information. This research explores three forms: lies of omission, lies of commission, and lies of influence, focusing primarily on lies of omission. We introduce a novel NLP framework supported by an annotated dataset of 876,784 samples from merged fake-news sources and Times of India headlines. Each sample is labeled for omission type (e.g., speculation, bias), “color” of lie (black/white/gray/red), intent (influence, prestige), and topic (political, educational, religious, etc.). Our multi-task learning pipeline, which merges fine-tuned language models, attains an F1 score of 0.87 across all annotation layers. We also examine correlations between omission-based lies and propaganda techniques—e.g., loaded language often signals opinion—and will release both model and dataset under an open license.},
 archiveprefix = {arXiv},
 author = {Anku Rani and Dwip Dalal and Shreya Gautam and Pankaj Gupta and Vinija Jain and Aman Chadha and Amit Sheth and Amitava Das},
 eprint = {2312.00292},
 primaryclass = {cs.CL},
 selected = {true},
 title = {SEPSIS: I Can Catch Your Lies -- A New Paradigm for Deception Detection},
 url = {https://arxiv.org/abs/2312.00292},
 year = {2023}
}

@misc{Pawar2024ContextSurvey,
 abstract = {Large language models (LLMs) excel in text comprehension and generation, but struggle with limited context windows. This survey dissects the motivations behind context-length extension, evaluates existing techniques—including memory augmentation, sliding-window attention, recurrence, positional interpolation, and retrieval-based methods—examines current evaluation standards, and highlights unresolved challenges. It serves as a comprehensive resource for researchers navigating the evolving long-context landscape.},
 archiveprefix = {arXiv},
 author = {Saurav Pawar and S. M. T. Islam Tonmoy and S. M. Zaman and Vinija Jain and Aman Chadha and Amitava Das},
 eprint = {2401.07872},
 primaryclass = {cs.CL},
 title = {The What, Why, and How of Context Length Extension Techniques in Large Language Models -- A Detailed Survey},
 url = {https://arxiv.org/abs/2401.07872},
 year = {2024}
}

@misc{Tonmoy2024HallucinationMitigation,
 abstract = {As LLMs advance, hallucination—the generation of content that seems factual but is ungrounded—remains a critical obstacle to safe deployment. This survey reviews over 32 mitigation methods, including retrieval-augmented generation (RAG), knowledge retrieval, CoNLI, and CoVe. We propose a taxonomy structured around dataset utilization, task type, feedback mechanisms, and retriever architecture, and discuss strengths, weaknesses, and open challenges.},
 archiveprefix = {arXiv},
 author = {S. M. T. Islam Tonmoy and S. M. Mehedi Zaman and Vinija Jain and Anku Rani and Vipula Rawte and Aman Chadha and Amitava Das},
 eprint = {2401.01313},
 primaryclass = {cs.CL},
 title = {A Comprehensive Survey of Hallucination Mitigation Techniques in Large Language Models},
 url = {https://arxiv.org/abs/2401.01313},
 year = {2024}
}

@misc{Rawte2023FoundationHalluc,
 abstract = {Hallucination in foundation models (text, vision, audio, video) refers to output that is plausible but factually mistaken. This paper provides a comprehensive overview: defining hallucination types (intrinsic/extrinsic), categorizing causes, evaluating mitigation strategies, and offering a unified framework for assessing and addressing hallucination across modalities.},
 archiveprefix = {arXiv},
 author = {Vipula Rawte and Amit Sheth and Amitava Das},
 eprint = {2309.05922},
 primaryclass = {cs.AI},
 title = {A Survey of Hallucination in Large Foundation Models},
 url = {https://arxiv.org/abs/2309.05922},
 year = {2023}
}

@misc{Rawte2023PromptLinguistics,
 abstract = {As large language models (LLMs) have advanced, they display a form of “hallucination”—producing plausible yet factually incorrect information. In this exploratory study, we examine how prompt characteristics—readability, formality, and concreteness—influence hallucination rates. We compile an annotated dataset derived from New York Times event-related tweets and evaluate hallucination occurrences across multiple LLMs. Our findings suggest that prompts with higher formality and concreteness significantly reduce hallucination, while the impact of readability is mixed. Results highlight the importance of prompt design in mitigating factual errors in LLM outputs.},
 archiveprefix = {arXiv},
 author = {Vipula Rawte and Prachi Priya and S. M. T. Islam Tonmoy and S. M. Mehedi Zaman and Amit Sheth and Amitava Das},
 eprint = {2309.11064},
 primaryclass = {cs.AI},
 title = {Exploring the Relationship between LLM Hallucinations and Prompt Linguistic Nuances: Readability, Formality, and Concreteness},
 url = {https://arxiv.org/abs/2309.11064},
 year = {2023}
}

@misc{Yip2023RESTORE,
 abstract = {Following the success of word embeddings, graph embeddings (GEs) have grown in popularity—but intrinsic evaluation methods are lacking. We propose RESTORE, an intrinsic evaluation framework that assesses graph embeddings via their ability to reconstruct the original graph’s topology and semantics. We evaluate on multiple embedding families (factorization-, random-walk-, and deep learning-based) using the CommonSense Knowledge Graph. Results show (1) deep-learning embeddings (SDNE) perform better on multi-hop topological reconstruction (mAP of 0.54 for 2 hops, 0.35 for 3 hops), and (2) factorization-based methods (HOPE) better capture semantic similarity. Our framework offers insights into embedding fidelity beyond downstream task performance.},
 archiveprefix = {arXiv},
 author = {Hiu Ying Yip and Chandra Ravuru and Neeloy Banerjee and Shashwat Jha and Amit Sheth and Aman Chadha and Amitava Das},
 eprint = {2308.14659},
 primaryclass = {cs.LG},
 title = {RESTORE: Graph Embedding Assessment Through Reconstruction},
 url = {https://arxiv.org/abs/2308.14659},
 year = {2023}
}

@misc{Wang2024ContextLengthSurvey,
 abstract = {Recently, large language models (LLMs) have shown remarkable capabilities in understanding, reasoning, and generating language, but their ability to process long input sequences is constrained by computational and memory costs. This survey comprehensively reviews techniques for extending context length—such as architectural modifications, altered positional encodings, and novel attention mechanisms—across training, fine-tuning, and inference stages. We classify methods, discuss their trade-offs, and highlight limitations and future research directions.},
 archiveprefix = {arXiv},
 author = {Xindi Wang and Mahsa Salmani and Parsa Omidi and Xiangyu Ren and Mehdi Rezagholizadeh and Armaghan Eshaghi},
 eprint = {2402.02244},
 primaryclass = {cs.CL},
 title = {Beyond the Limits: A Survey of Techniques to Extend the Context Length in Large Language Models},
 url = {https://arxiv.org/abs/2402.02244},
 year = {2024}
}

@misc{Liu2024LVLMHallucinationSurvey,
 abstract = {Large vision-language models (LVLMs) have advanced multi-modal AI applications, but often suffer from “hallucination”—a misalignment between visual input and textual output. In this survey, we clarify hallucination in LVLMs, categorize different symptoms, review existing benchmarks and evaluation methods, analyze root causes (e.g., training data, model components), and summarize mitigation techniques. We conclude with open challenges and future directions for reducing multimodal hallucinations.},
 archiveprefix = {arXiv},
 author = {Hanchao Liu and Wenyuan Xue and Yifei Chen and Dapeng Chen and Xiutian Zhao and Ke Wang and Liping Hou and Rongjun Li and Wei Peng},
 eprint = {2402.00253},
 primaryclass = {cs.CV},
 title = {A Survey on Hallucination in Large Vision-Language Models},
 url = {https://arxiv.org/abs/2402.00253},
 year = {2024}
}

@misc{Huang2023LLMHallucinationSurvey,
 abstract = {Given the generic and open-ended nature of LLMs, hallucinations present unique challenges compared to task-specific models. In this survey, we propose an innovative taxonomy of hallucinations, analyze contributing factors, and provide a thorough overview of detection methods and benchmarks. We further assess mitigation strategies, identify limitations in retrieval-augmented LLMs, and discuss future directions to build more robust models.},
 archiveprefix = {arXiv},
 author = {Lei Huang and Weijiang Yu and Weitao Ma and Weihong Zhong and Zhangyin Feng and Haotian Wang and Qianglong Chen and Weihua Peng and Xiaocheng Feng and Bing Qin and Ting Liu},
 eprint = {2311.05232},
 primaryclass = {cs.CL},
 title = {A Survey on Hallucination in Large Language Models: Principles, Taxonomy, Challenges, and Open Questions},
 url = {https://arxiv.org/abs/2311.05232},
 year = {2023}
}

@inproceedings{Das2025_DPODkernels,
 abbr = {ACL 2025},
 abstract = {We present DPO Kernels, combining kernel density estimation with divergence-based objectives for direct preference optimization in large language models. By incorporating semantics via custom kernel functions, DPO Kernels significantly improve the alignment between model outputs and human preferences. Experiments on public preference datasets show gains of 3-5% over existing DPO approaches, demonstrating improved generation quality and user satisfaction.},
 author = {Amitava Das and Sameer Trivedy and Deepansh Khanna and Rishabh Roy and Gautam Singh and Biswarup Ghosh and Yogesh Narsupalli and Vivek Jain and Vivek Sharma and Aishwarya Reganti and Aman Chadha},
 booktitle = {Proceedings of ACL 2025},
 note = {A*},
 pdf = {https://arxiv.org/pdf/2501.03271.pdf},
 selected = {true},
 series = {ACL},
 title = {DPO Kernels: A Semantically-Aware, Kernel-Enhanced, and Divergence-Rich Paradigm for Direct Preference Optimization},
 year = {2025}
}

@inproceedings{Das2025_YinYangAlign,
 abbr = {ACL 2025},
 abstract = {YINYANG-ALIGN is a novel benchmark and training framework for text-to-image alignment that concurrently optimizes for coherence and diversity, conceptually contradictory objectives. We propose multi-objective DPO training that balances these via Pareto optimality. Evaluated on standard T2I datasets, YINYANG-ALIGN achieves higher user preference and diversity metrics without sacrificing fidelity.},
 author = {Amitava Das and Yogesh Narsupalli and Gautam Singh and Vivek Jain and Vivek Sharma and Sameer Trivedy and Aman Chadha and Aishwarya Sheth},
 booktitle = {Proceedings of ACL 2025},
 note = {A*},
 pdf = {https://arxiv.org/pdf/2502.03512.pdf},
 selected = {true},
 series = {ACL},
 title = {YINYANG-ALIGN: Benchmarking Contradictory Objectives and Proposing Multi-Objective Optimization based DPO for Text-to-Image Alignment},
 year = {2025}
}

@inproceedings{Wijesiriwardene2025_ProportionalAnalogies,
 abbr = {ACL 2025},
 abstract = {This work investigates LLMs' capability on analogical reasoning (e.g., A:B :: C:? queries) with knowledge-enhanced prompts. We design knowledge retrieval modules that inject relevant facts into prompts, enhancing model performance by ~12% on proportional analogy datasets. Analyses reveal improvements when symbolic knowledge complements contextual embeddings.},
 author = {T. Wijesiriwardene and R. Wickramarachchi and S. R. Vennam and Vivek Jain and Aman Chadha and Amitava Das and Prateek Kumaraguru and Aishwarya Sheth},
 booktitle = {Proceedings of COLING 2025},
 note = {B},
 pdf = {https://aclanthology.org/2025.coling-main.268.pdf},
 selected = {true},
 series = {COLING},
 title = {Exploring the Abilities of Large Language Models to Solve Proportional Analogies via Knowledge-Enhanced Prompting},
 year = {2025}
}

@inproceedings{Dixit2025_PECCAVI,
 abstract = {PECCAVI introduces a novel distortion-free watermarking scheme resilient to visual paraphrasing attacks, where an image’s semantics are preserved but styling is changed. Through dual-space embedding and signal-preserving transformations, PECCAVI achieves over 90% watermark robustness under various paraphrasing attack scenarios, while maintaining visual fidelity.},
 author = {Siddharth Dixit and Adeel Aziz and Vivek Sharma and Aman Chadha and Aishwarya Reganti and Aishwarya Sheth and Amitava Das},
 booktitle = {ICCV 2025 (submitted)},
 note = {A*},
 series = {ICCV},
 title = {PECCAVI - Visual Paraphrase Attack Safe and Distortion-Free Image Watermarking Technique for AI-Generated Images},
 year = {2025}
}

@inproceedings{Kavathekar2024_CT2,
 abbr = {EMNLP 2024},
 abstract = {We introduce the Hindi AI Detectability Index (ADIhi), a benchmark suite and evaluation metric for detecting AI-generated Hindi text. We compile a corpus of 20K human-written and LLM-generated texts and evaluate detectors including token-level, syntactic, and stylometric features. Results indicate existing detectors struggle on code-mixed content and slang; using ADIhi, we rank LLMs and propose improvements tailored for Hindi.},
 author = {Isha Kavathekar and Anku Rani and Ananya Chamoli and Prateek Kumaraguru and Aishwarya Sheth and Amitava Das},
 booktitle = {Findings of EMNLP 2024},
 pdf = {https://arxiv.org/pdf/2407.15694.pdf},
 selected = {true},
 title = {Counter Turing Test (CT2): Investigating AI-Generated Text Detection for Hindi},
 year = {2024}
}

@inproceedings{Wijesiriwardene2024_SentAnalogy,
 abstract = {This study examines whether pre-trained LLMs capture sentence structural features necessary for solving analogies (e.g., “The cat sat on the mat” : “The dog lay in the yard”). We design probing tasks and evaluate models like BERT and LLaMA. Results suggest strong correlation between structural encoding and analogy accuracy; fine-tuning on structural signals improves performance by ~8%.},
 author = {T. Wijesiriwardene and R. Wickramarachchi and Aishwarya Reganti and Vivek Jain and Aman Chadha and Amitava Sheth and Amitava Das},
 booktitle = {EACL 2024 Findings},
 note = {A},
 title = {On the Relationship between Sentence Analogy Identification and Sentence Structure Encoding in Large Language Models},
 year = {2024}
}

@inproceedings{Rawte2023_FACTIFY3M,
 abbr = {ACL 2023},
 abstract = {We present FACTIFY3M, a multimodal factual verification benchmark that combines images, text, and explanations grounded in 5W QA. The dataset includes 50K multimodal claims with annotated 5WQA pairs and supporting sources. Baseline models using joint vision-language transformers achieve 74.5% accuracy, but leave room for improvement; the 5W explanations improve interpretability and diagnostic evaluation.},
 author = {Vipula Rawte and Amitava Das},
 booktitle = {Proceedings of EMNLP 2023},
 note = {Oral, A*},
 selected = {true},
 title = {FACTIFY3M: A benchmark for multimodal fact verification with explainability through 5W Question-Answering},
 year = {2023}
}

@inproceedings{Rawte2023_HallucEmergence,
 abbr = {EMNLP 2023},
 abstract = {This paper introduces a formal definition and taxonomy for LLM hallucinations, proposes automatic metrics for hallucination quantification (e.g., hallucination density, factual error scores), and presents remediations such as knowledge grounding, self-critique modules, and multi-step prompting. In experiments across GPT-3, BERT, and open-source LLMs, these countermeasures reduce hallucination by up to 35%.},
 author = {Vipula Rawte and S. Chakraborty and A. Pathak and A. Sarkar and SMTI Tonmoy and Aman Chadha and Aishwarya Sheth and Amitava Das},
 booktitle = {Proceedings of EMNLP 2023},
 doi = {10.18653/v1/2023.emnlp-main.155},
 note = {Oral, A*},
 pdf = {https://aclanthology.org/2023.emnlp-main.155.pdf},
 selected = {true},
 title = {The Troubling Emergence of Hallucination in Large Language Models - An Extensive Definition, Quantification, and Prescriptive Remediations},
 year = {2023}
}

@inproceedings{Chakraborty2023_CounterTuring,
 abbr = {EMNLP 2023},
 abstract = {This paper demonstrates that standard token- and syntax-based detectors poorly generalize to AI-generated text in Hindi and code-mixed domains. We propose CT2 detection models that leverage stylometric and structural features, improving cross-domain robustness by 12%. We release CT2 dataset and models for future research.},
 author = {Shreya Chakraborty and Aman Chadha and Aishwarya Sheth and Amitava Das},
 booktitle = {EMNLP 2023},
 note = {A*},
 pdf = {https://arxiv.org/pdf/2310.05030.pdf},
 selected = {true},
 title = {Counter Turing Test (CT2): AI-Generated Text Detection is Not as Easy as You May Think},
 year = {2023}
}

@inproceedings{Wijesiriwardene2023_ANALOGICAL,
 abstract = {We introduce ANALOGICAL, the first benchmark targeting analogy reasoning in long-form text. It includes 5K human-crafted long-text analogies across narrative domains. Evaluation of LLMs (GPT-3, LLaMA) shows <40% accuracy. We analyze failure modes and propose structure-aware embeddings that improve performance by ~15%.},
 author = {T. Wijesiriwardene and R. Wickramarachchi and B. Gajera and S. Gowaikar and C. Gupta and A. Chadha and A. Reganti and A. Sheth and A. Das},
 booktitle = {Proceedings of ACL 2023},
 note = {Findings, A*},
 title = {ANALOGICAL - A New Benchmark for Analogy of Long Text for Large Language Models},
 year = {2023}
}

@inproceedings{Rani2023_FACTIFY5WQA,
 abstract = {We propose FACTIFY-5WQA, a fact verification model that formulates evidence retrieval and claim assessment as an answer generation to “who/what/when/where/why” questions. Evaluated on FEVER and MultiFC, our model shows 5-8% gains over retrieval-based baselines, and provides interpretable outputs via generated 5W answers.},
 author = {A. Rani and S. M. Tonmoy and D. Dalal and S. Gautam and M. Chakraborty and A. Chadha and A. Sheth and A. Das},
 booktitle = {Proceedings of ACL 2023},
 note = {Oral, A*},
 title = {FACTIFY-5WQA: 5W Aspect-based Fact Verification through Question Answering},
 year = {2023}
}

@inproceedings{Mohammed2023_CONFLATOR,
 abstract = {CONFLATOR introduces a rotary positional encoding sensitive to code-switching points, enhancing modeling for bilingual text. Evaluated on English-Hindi-Bengali data, it reduces perplexity by 12% compared to standard RoPE and improves downstream tasks like language identification and translation.},
 author = {M. Mohammed and S. Kandukuri and N. Gupta and P. Patwa and A. Chatterjee and V. Jain and A. Chadha and A. Das},
 booktitle = {6th Workshop on Computational Approaches to Linguistic Code-Switching (AACL), ACL 2023},
 note = {A},
 title = {CONFLATOR: Incorporating Switching Point-based Rotatory Positional Encodings for Code-Mixed Language Modeling},
 year = {2023}
}

@inproceedings{Ali2022_PESTO,
 abstract = {PESTO designs dynamic positional encodings guided by code-switching points and integrates relative positions within mixed segments. This enhances modeling of bilingual utterances in English-Hindi and English-Bengali corpora, improving language modeling perplexity by 8% over baselines.},
 author = {M. Ali and S. T. Kandukuri and S. Manduru and P. Patwa and A. Das},
 booktitle = {AAAI 2022},
 note = {Student Abstract, A*},
 title = {PESTO: Switching Point-Based Dynamic and Relative Positional Encoding for Code-Mixed Languages},
 year = {2022}
}

@inproceedings{Gunti2022_Memotion,
 abstract = {We present a joint embedding framework combining textual and visual features to analyze memes—detecting sentiment, humor, sarcasm, and offensiveness. On a curated English-Hindi meme dataset, our approach achieves over 70% accuracy across multiple tasks, outperforming text-only baselines by 12%.},
 author = {N. Gunti and S. Ramamoorthy and P. Patwa and A. Das},
 booktitle = {AAAI 2022},
 note = {Student Abstract, A*},
 title = {Memotion Analysis through the Lens of Joint Embedding},
 year = {2022}
}

@inproceedings{Dutta2021_HateInfodemic,
 abstract = {We introduce a topic-aware diffusion model to study the spread of hate speech on Twitter, treating it as an infodemic. By integrating topic modeling with user engagement features (retweets, followers), we identify topics that significantly amplify hate. Evaluation on large-scale event-based data shows our model predicts hateful tweet virality with 85% accuracy and enables targeted intervention strategies.},
 author = {S. Dutta and S. Masud and Sa. Makkar and C. Jain and V. Goyal and A. Das and T. Chakraborty},
 booktitle = {IEEE ICDE 2021},
 note = {A1},
 title = {Hate is the New Infodemic: A Topic-aware Modeling of Hate Speech Diffusion on Twitter},
 year = {2021}
}

@inproceedings{Guptha2020_MinoritySampling,
 abstract = {This paper presents a sampling strategy to over-sample minority code-switching points in mixed-language corpora. Using English-Hindi data, we show that balanced sampling around switch points reduces perplexity by 7.4% and improves language modeling performance near bilingual boundaries.},
 author = {V. Guptha and A. Chatterjee and P. Chopra and A. Das},
 booktitle = {LREC 2020},
 note = {Poster},
 title = {Minority Positive Sampling for Switching Points - an Anecdote for the Code-Mixing Language Modeling},
 year = {2020}
}

@inproceedings{Rudrapal2018_CICLING_SRL,
 abstract = {We propose an SRL system adapted to Twitter's noisy text, using a CRF classifier with features from syntax, POS tagging, and lexical patterns. On a manually annotated tweet dataset, the system achieves 68.9% F₁, outperforming off-the-shelf SRL tools by ∼15%.},
 author = {D. Rudrapal and A. Das},
 booktitle = {CICLING 2018},
 note = {Oral, B},
 title = {Semantic Role Labeling of English Tweets},
 year = {2018}
}

@inproceedings{Kumar2018_CVSubwords,
 abstract = {We propose using consonant-vowel (CV) substrings as subword units to model code-mixed text, addressing inconsistent orthography in English-Hindi mixing. We show CV-based segmentation yields a 9% reduction in perplexity over character-level models and improves downstream performance on translation and named-entity recognition tasks.},
 author = {U. Kumar and V. S. Rana and C. Andrew and S. Gongidi and A. Das},
 booktitle = {AAAI 2018},
 note = {Poster, A*},
 title = {Consonant-Vowel Sequences as Subword Units for Code-Mixed Languages},
 year = {2018}
}

@inproceedings{Maheshwari2017_ISISVulnerability,
 abstract = {This study investigates psychological and social traits of Twitter users who support ISIS. Using psycholinguistic features from LIWC and network centrality measures, we identify markers like high anxiety, social isolation, and echo-chamber engagement. The analysis highlights how psycho-social vulnerability contributes to extremist content endorsement and helps inform early detection frameworks.},
 author = {T. Maheshwari and A. Reganti and A. Das and T. Chakraborty and P. Kumaraguru},
 booktitle = {ASONAM 2017},
 note = {Poster, A},
 pages = {621--624},
 title = {Understanding the Psycho-Sociological Vulnerability of ISIS Patronizers on Twitter},
 year = {2017}
}

@inproceedings{Rudrapal2017_Quotology,
 abstract = {We present 'Quotology', a framework for analyzing implied meanings in quotations. By extracting clauses and applying entailment checks, we detect implied nuance such as sarcasm or irony. Evaluation on a dataset of political quotations shows 78% accuracy in identifying implied sentiment, outperforming baseline sentiment analysis systems.},
 author = {D. Rudrapal and A. Das and B. Bhattacharya},
 booktitle = {NLDB 2017},
 note = {Poster, B},
 pages = {292--296},
 title = {Quotology - Reading Between the Lines of Quotations},
 year = {2017}
}

@inproceedings{Maheshwari2017_SocioEthnic,
 abstract = {This paper analyzes how socio-ethnic attributes (e.g., caste, religion, region) shape online community formation. Using unsupervised clustering of user metadata and chat content, we uncover that ethnic identity significantly influences community boundaries, more so than shared interests. These findings highlight the social stratification embedded in digital interactions.},
 author = {T. Maheshwari and A. Reganti and T. Chakraborty and A. Das},
 booktitle = {CSCW 2017},
 note = {Poster, A},
 pages = {235--238},
 title = {Socio-Ethnic Ingredients of Social Network Communities},
 year = {2017}
}

@inproceedings{Maheshwari2017_SocietalSentiment,
 abstract = {We propose a methodology to infer individuals’ ethical and value orientations by analyzing their social media text. Using linguistic cues and value lexica, we train classifiers predicting Schwartz’s values (e.g., benevolence, conformity). Evaluation on survey-validated users achieves 68% accuracy, suggesting language reflects underlying moral dimensions.},
 author = {T. Maheshwari and A. N. Reganti and S. Gupta and A. Jamatia and U. Kumar and B. Gambäck and A. Das},
 booktitle = {EACL 2017},
 note = {Oral, A},
 pages = {731--741},
 title = {A Societal Sentiment Analysis: Predicting the Values and Ethics of Individuals by Analyzing Social Media Content},
 year = {2017}
}

@inproceedings{Reganti2017_SemanticInterpretation,
 abstract = {We introduce a semantic interpretation framework for characterizing social network communities. By mapping topic models to ontology concepts and psycholinguistic traits, we generate semantic labels (e.g., 'eco-activists', 'tech enthusiasts') for communities. A user study shows 82% agreement with expert-generated labels, highlighting the model’s utility in summarizing community semantics.},
 author = {A. N. Reganti and T. Maheshwari and U. Kumar and T. Chakraborty and A. Das and A. Sheth},
 booktitle = {AAAI 2017},
 note = {Poster, A*},
 pages = {4967--4968},
 title = {Semantic Interpretation of Social Network Communities},
 year = {2017}
}

@inproceedings{Gamback2016_CodeSwitchLevels,
 abstract = {We compare multiple multilingual corpora on their degree of code-switching, using metrics like language mix density and switch frequency. Our analysis across nine corpora shows wide variation, and we propose a standardized framework for code-switching quantification. This aids in the selection and generation of corpora for modeling code-mixed language phenomena.},
 author = {B. Gambäck and A. Das},
 booktitle = {LREC 2016},
 note = {Poster, A},
 pages = {1850--1855},
 title = {Comparing the Level of Code-Switching in Corpora},
 year = {2016}
}

@inproceedings{Jamatia2016_CollectingCodeMixed,
 abstract = {We present the methodology for harvesting, filtering, and annotating a large-scale code-mixed English-Hindi corpus from Twitter and Facebook. We describe annotation guidelines for language tags, part-of-speech, and transliteration, and analyze corpus properties. The resulting corpus enables improved downstream models for code-mixed NLP.},
 author = {A. Jamatia and B. Gambäck and A. Das},
 booktitle = {CICLING 2016},
 note = {Oral, B},
 pages = {3--9},
 title = {Collecting and Annotating Indian Social Media Code-Mixed Corpora},
 year = {2016}
}

@inproceedings{Jamatia2015_POSCodeMixed,
 abstract = {This paper addresses POS tagging in code-mixed English-Hindi chat data. We train CRF models with novel features such as transliteration consistency and bilingual context windows. Experiments show 88.4% tagging accuracy, outperforming monolingual baselines by ~10%.},
 author = {A. Jamatia and B. Gambäck and A. Das},
 booktitle = {RANLP 2015},
 note = {Oral, B},
 pages = {239--248},
 title = {Part-of-Speech Tagging for Code-Mixed English-Hindi Twitter and Facebook Chat Messages},
 year = {2015}
}

@inproceedings{Sarma2014_HealthBehaviorRobots,
 abstract = {We propose a robot-based framework to encourage health behavior change via personalized dialogue, emotional rapport, and goal tracking. Using consumer health data and motivational interviewing techniques, the system adapts recommendations. A pilot with 30 participants shows improved engagement and self-reported activity confidence.},
 author = {B. Sarma and A. Das and R. Nielsen},
 booktitle = {INLG 2014},
 note = {Poster, B},
 pages = {103--107},
 title = {A Framework for Health Behavior Change using Companionable Robots},
 year = {2014}
}

@inproceedings{Das2013_SentimentalEyes,
 abstract = {We introduce “Sentimental Eyes!”, a system that visualizes real-time sentiment from text streams via emotion-aware emoticons and color mapping. Applied to chat logs, users reported improved mood awareness and communication moderation. An evaluation with 50 users shows increased sentiment awareness and higher conversation satisfaction.},
 author = {A. Das and B. Gambäck},
 booktitle = {Proceedings of HCI 2013},
 note = {Poster, A},
 pages = {310--318},
 title = {Sentimental Eyes!},
 year = {2013}
}

@inproceedings{Das2012_5WStructure,
 abstract = {We propose a framework that structures sentiment summaries around the “Who, What, When, Where, Why” dimensions. Applied to Twitter, this enables flexible query-based summarization and interactive visualization. Our evaluations suggest improved user comprehension and efficient tracking of sentiment trends over time.},
 author = {Amitava Das and Sivaji Bandyopadhyay and Björn Gambäck},
 booktitle = {CICLING 2012},
 note = {Oral, B},
 pages = {540--555},
 title = {The 5W Structure for Sentiment Summarization-Visualization-Tracking},
 year = {2012}
}

@inproceedings{Das2011_PsychoSentiWordNet,
 abstract = {We introduce PsychoSentiWordNet, a sentiment lexicon augmented with psycho-linguistic attributes (e.g., concreteness, valence, arousal). By combining lexical and psychological dimensions, it enhances sentiment analysis, particularly in emotional intensity estimation. Evaluations on benchmark datasets show improved performance over SentiWordNet-based systems.},
 author = {Amitava Das},
 booktitle = {Proceedings of ACL 2011},
 note = {Poster, A*},
 pages = {52--57},
 title = {PsychoSentiWordNet},
 year = {2011}
}

@inproceedings{Das2011_DrSentiment,
 abstract = {This demo presents “Dr Sentiment”, a system that explains sentiment analysis via concept graphs derived from WordNet and SentiWordNet. It visualizes sentiment flow and reasoning paths. A usability study with users (N=40) shows improved trust and transparency compared to standard sentiment scores.},
 author = {Amitava Das and Sivaji Bandyopadhyay},
 booktitle = {ACL/HLT 2011},
 note = {Demo, A*},
 pages = {50--55},
 title = {Dr Sentiment Knows Everything!},
 year = {2011}
}

@inproceedings{Das2010_PragmaLex,
 abstract = {We explore incorporating pragmatic knowledge—e.g., implicature, presupposition—into a computational lexicon. We extend an existing lexical resource with pragmatics annotations and evaluate on inference tasks requiring context understanding. Results show improved performance in counterfactual and implicature detection, highlighting lexicon-based pragmatics’ potential.},
 author = {Amitava Das},
 booktitle = {ICON 2010},
 note = {Oral, Best Student Paper},
 pages = {-},
 title = {Can We Mimic Human Pragmatics Knowledge in a Computational Lexicon?},
 year = {2010}
}

@article{Zafar2024_KIMAG,
 abbr = {Neurocomputing},
 abstract = {The KI-MAG system integrates BART-based abstractive QA with medical knowledge graphs, improving answer precision by ~15%. Evaluation on synthetic and real medical QA shows increased semantic correctness and reduced hallucinations by embedding entities from UMLS and PharmKG into its generation pipeline.},
 author = {A. Zafar and S.K. Sahoo and H. Bhardawaj and A. Das and A. Ekbal},
 doi = {10.1016/j.neucom.2023.127141},
 issn = {0925-2312},
 journal = {Neurocomputing},
 pages = {127141},
 title = {KI-MAG: A knowledge-infused abstractive question answering system in medical domain},
 volume = {571},
 year = {2024}
}

@article{Zafar2024_AppliedIntelligence,
 abstract = {This work introduces a knowledge-enabled QA model leveraging Medical Entity Scoring (MES) and Context Relevance Scoring (CRS) to enrich answers with medical knowledge from UMLS and PharmKG. Evaluations on MASH-QA & COVID-QA show state-of-the-art results in both automated and human assessment, achieving improved factuality and relevance.},
 author = {A. Zafar and D. Varshney and S.K. Sahoo and A. Das and A. Ekbal},
 doi = {10.1007/s10489-024-05282-8},
 journal = {Applied Intelligence},
 pages = {2172--2187},
 title = {Are my answers medically accurate? Exploiting medical knowledge graphs for medical question answering},
 volume = {54},
 year = {2024}
}

@article{Zafar2024_JIIS,
 abstract = {KIMedQA integrates pruned medical knowledge graphs with context and query representations using pre-trained LMs to generate informed answers. Evaluated on MASH-QA and COVID-QA, the model establishes new state-of-the-art performance by selectively filtering relevant KG subgraphs.},
 author = {A. Zafar and S.K. Sahoo and D. Varshney and A. Das and A. Ekbal},
 doi = {10.1007/s10844-024-00844-1},
 journal = {Journal of Intelligent Information Systems},
 pages = {833--858},
 title = {KIMedQA: towards building knowledge-enhanced medical QA models},
 volume = {62},
 year = {2024}
}

@article{Wijesiriwardene2023_NeurosymbolicAI,
 abbr = {IEEE IS},
 abstract = {This article argues that pragmatic analogy understanding requires both symbolic logical reasoning and neural modeling. Neurosymbolic AI, combining deep learning and symbolic methods, is essential to model nuanced analogies in human communication.},
 author = {T. Wijesiriwardene and A. Sheth and V.L. Shalin and A. Das},
 doi = {10.1109/MIS.2023.3305862},
 journal = {IEEE Intelligent Systems},
 number = {5},
 pages = {12--16},
 title = {Why Do We Need Neurosymbolic AI to Model Pragmatic Analogies?},
 volume = {38},
 year = {2023}
}

@article{PYKL2022_ExpertSysAppl,
 abbr = {ESWA},
 abstract = {We explore psycho-sociological characteristics of fake vs real news spreaders via personality traits (Narcissism, Machiavellianism). Leveraging Twitter diffusion data, a predictive model identifies fake spreaders exhibiting high narcissism and low Machiavellianism, while real spreaders show opposite patterns. Results demonstrate the model’s effectiveness in predicting spreader type.},
 author = {S.P.Y.K.L. and A. Das and V. Pulabaigari},
 doi = {10.1016/j.eswa.2022.117952},
 issn = {0957-4174},
 journal = {Expert Systems with Applications},
 pages = {117952},
 title = {Fake spreader is narcissist; Real spreader is Machiavellian prediction of fake news diffusion using psycho-sociological facets},
 volume = {207},
 year = {2022}
}

@article{Rudrapal2021_TweetRanking,
 abstract = {A Twitter event may generate a huge, noisy stream of tweets containing both relevant updates and irrelevant chatter. This paper presents a learning-to-rank framework that exploits enriched features—including content-popularity, keyword distribution, sentiment, hashtag usage, and tweet length—to rank tweets for relevance and informativeness. Experiments on real-world datasets show that our method effectively filters out noise and surfaces informative tweets with robust performance.},
 author = {D. Rudrapal and A. Das and B. Bhattacharya},
 doi = {10.13053/cys-23-2-3011},
 journal = {Computing and Systems},
 number = {2},
 pages = {491--500},
 title = {Ranking of Event-focused English Tweets Based on Relevance and Informativeness},
 volume = {23},
 year = {2021}
}

@article{Jamatia2020_AITools,
 abstract = {This work addresses sentiment analysis on code-mixed English-Hindi and English-Bengali content from social media, a challenging task due to informal style and mixed language use. Three deep neural architectures (BiLSTM-CNN, double BiLSTM, attention-based models) are compared to traditional classifiers. Results show deep models, especially BiLSTM-CNN and attention-based ones, outperform conventional methods by 20-60% in accuracy, demonstrating their effectiveness for code-mixed sentiment detection.},
 author = {A. Jamatia and S. D. Swamy and B. Gambäck and A. Das},
 doi = {10.1142/S0218213020500141},
 issn = {0218-2130},
 journal = {International Journal on Artificial Intelligence Tools},
 number = {5},
 pages = {2050014},
 title = {Deep Learning Based Sentiment Analysis in a Code-Mixed English-Hindi and English-Bengali Social Media Corpus},
 volume = {29},
 year = {2020}
}

@article{Rudrapal2019_PartialEntailment,
 abstract = {This paper presents a system for detecting partial textual entailment in noisy code-mixed Indian social media texts (English-Hindi, English-Bengali). By adapting features like overlap, negation, and semantic roles, the model shows effectiveness in identifying entailment despite informal structure and colloquialism. It demonstrates the potential for improving downstream tasks like summarization and contradiction detection in Indian social media.},
 author = {D. Rudrapal and A. Das and B. Bhattacharya},
 doi = {10.13053/cys-23-1-2816},
 journal = {Computing and Systems},
 number = {1},
 pages = {143--152},
 title = {Recognition of Partial Textual Entailment for Indian Social Media Text},
 volume = {23},
 year = {2019}
}

@article{Solomon2019_Homophily,
 abbr = {IEEE CIM},
 abstract = {We analyze how psycho-sociological traits like personality and values drive homophily in online communities. Using large-scale Twitter data, we map linguistic markers to Myers-Briggs and Schwartz value traits. Findings show significant clustering—communities form based on shared traits—even when content differs, underscoring psychological attraction as a foundational principle in social media ties.},
 author = {R. S. Solomon and S. P. Y. K. L. and A. Das and B. Gambäck and T. Chakraborty},
 doi = {10.1109/MCI.2019.2901084},
 journal = {IEEE Computational Intelligence Magazine},
 number = {2},
 pages = {28--40},
 title = {Understanding the Psycho-Sociological Facets of Homophily in Social Network Communities},
 volume = {14},
 year = {2019}
}

@article{Jamatia2019_LangID,
 abstract = {Word-level language identification in code-mixed social media text—English-Hindi and English-Bengali—is tackled using deep learning. Bidirectional LSTM models are compared with CRF classifiers. Results show BiLSTM models outperform CRF, with best model achieving ~87% accuracy and F-score. This demonstrates deep architectures' capacity to handle noisy and blended language data.},
 author = {A. Jamatia and A. Das and B. Gambäck},
 doi = {10.1515/jisys-2017-0440},
 journal = {Journal of Intelligent Systems},
 number = {3},
 pages = {399--408},
 title = {Deep Learning-Based Language Identification in English-Hindi-Bengali Code-Mixed Social Media Corpora},
 volume = {28},
 year = {2019}
}

@article{Chakma2019_DeepSRL_5W1H,
 abstract = {We implement a deep neural network with attention mechanism for semantic role labeling in the 5W1H style on tweets. The model achieves an F₁ score of 88.21%, outperforming previous Twitter SRL systems by about 28.7%. By simplifying traditional PropBank roles into journalistic 5W1H categories, we improve readability and performance for noisy social media text.},
 author = {K. Chakma and A. Das and S. Debbarma},
 doi = {10.13053/cys-23-3-3253},
 journal = {Computing and Systems},
 number = {3},
 pages = {751--763},
 title = {Deep Semantic Role Labeling for Tweets using 5W1H: Who, What, When, Where, Why and How},
 volume = {23},
 year = {2019}
}

@article{Rudrapal2019_TwitterSummarization,
 abstract = {We propose a two-phase summarization pipeline: first ranking event-related tweets and extracting key sentences, then using Partial Textual Entailment (PTE) to reduce redundancy before generating an abstractive summary. Evaluation shows superior performance versus state-of-the-art baselines on real-time Twitter event data.},
 author = {D. Rudrapal and A. Das and B. Bhattacharya},
 doi = {10.13053/cys-23-3-3275},
 journal = {Computing and Systems},
 number = {3},
 pages = {1065--1078},
 title = {A New Approach for Twitter Event Summarization Based on Sentence Identification and Partial Textual Entailment},
 volume = {23},
 year = {2019}
}

@article{Solomon2018_TwitterSelectionalPreferences,
 abstract = {We investigate the semantic selectional preferences (e.g., verb-object choices) in Twitter mention networks. Using corpus-based frequency analyses, we link linguistic behavior to mention-based social connections, highlighting semantic patterns in user mention contexts on Twitter.},
 author = {R. Solomon and S. P. Y. K. L. Srinivas and A. Narayan and A. Das},
 journal = {International Journal of Computer and Information Engineering},
 number = {8},
 pages = {638--643},
 title = {Understanding the Selectional Preferences of the Twitter Mentions Network},
 volume = {12},
 year = {2018}
}

@article{Chakma2018_5W1HAnnotation,
 abstract = {We introduce a 5W1H annotation schema for semantic role labeling in tweets, adapting journalistic question categories (Who, What, When, Where, Why, How) to social media contexts. Our annotated corpus supports improved semantic parsing in noisy text.},
 author = {K. Chakma and A. Das},
 booktitle = {CICLING 2018},
 doi = {10.13053/cys-22-3-3016},
 journal = {Computing and Systems},
 note = {Oral, B},
 number = {3},
 pages = {747--755},
 title = {A 5W1H Based Annotation Scheme for Semantic Role Labeling of English Tweets},
 volume = {22},
 year = {2018}
}

@article{Rudrapal2018_SyntaxSRL,
 abstract = {This paper adapts traditional semantic role labeling (SRL) techniques to handle informal and noisy Twitter text. We build a dataset of annotated tweets and train a CRF-based SRL model, incorporating features like POS tags, lexical clusters, and dependency parses. The model achieves 72.3% F₁, demonstrating robustness in identifying predicate-argument structures in tweets despite irregular text patterns.},
 author = {D. Rudrapal and A. Das},
 doi = {10.13053/cys-22-3-3035},
 journal = {Computing and Systems},
 number = {3},
 pages = {739--746},
 title = {Semantic Role Labelling of English Tweets},
 volume = {22},
 year = {2018}
}

@article{Kumar2018_InducingValues,
 abstract = {We present a framework to estimate personality traits (Big Five) and value orientations (Schwartz) from language use in Twitter communities. Using psycholinguistic dictionaries, LIWC features, and topic modeling, we derive community-level trait distributions. Results reveal distinct personality profiles driving language patterns—e.g., openness correlates with creative topic usage—suggesting language-driven personality inference at group scale.},
 author = {U. Kumar and A. N. Reganti and T. Maheshwari and T. Chakraborty and B. Gambäck and A. Das},
 doi = {10.1007/s10796-017-9793-8},
 journal = {Information Systems Frontier},
 pages = {1219--1240},
 title = {Inducing Personalities and Values from Language Use in Social Network Communities},
 volume = {20},
 year = {2018}
}

@article{Solomon2018_HomophilyFriends,
 abbr = {IEEE CIM},
 abstract = {This study investigates homophily—tendency to connect with similar individuals—on Twitter by comparing interactions between friends, colleagues, and relatives. Using psycho-sociological language features, we find similarity-based homophily is stronger among friends than other relationship types, suggesting platform connections often reflect chosen social alignment over familial or professional ties.},
 author = {S. Solomon and S. P. Y. K. L. Srinivas and A. Das and T. Chakraborty and B. Gambäck},
 journal = {IEEE Computational Intelligence Magazine},
 number = {special issue},
 title = {Friends are the family we choose - Understanding the Psycho-Sociological Homophilic Nature amongst Friends, Relatives, and Colleagues in Twitter},
 volume = {13},
 year = {2018}
}

@article{Maheshwari2018_Psycholinguistic,
 abbr = {IEEE IS},
 abstract = {We analyze linguistic data from social network communities to uncover underlying psychological dimensions. Using LIWC and personality value metrics, we reveal significant clustering in psycholinguistic profiles, demonstrating that language use reflects community-level personality traits, cognition, and affect.},
 author = {T. Maheshwari and A. Reganti and U. Kumar and A. Das and T. Chakraborty},
 doi = {10.1109/MIS.2018.111144400},
 journal = {IEEE Intelligent Systems},
 number = {4},
 pages = {36--48},
 title = {Revealing Psycholinguistic Dimensions of Communities in Social Networks},
 volume = {33},
 year = {2018}
}

@article{Maheshwari2017_PsycholinguisticBehavior,
 abstract = {This paper examines how psycholinguistic traits—personality, sentiment, social orientation—can be mined from social media text. We apply computational linguistics tools, including LIWC and topic models, on Twitter datasets and validate findings against self-reported surveys. Results indicate strong alignment between inferred and actual traits, demonstrating linguistic analysis as a proxy for psychological profiling.},
 author = {T. Maheshwari and A. Reganti and U. Kumar and A. Das and T. Chakraborty and B. Gambäck},
 doi = {10.1007/s10796-016-9692-3},
 journal = {Information Systems Frontier},
 number = {special issue on Behavioral-Data Mining},
 pages = {1--17},
 title = {Mining Human Psycholinguistic Behavior from Social Media},
 volume = {19},
 year = {2017}
}

@article{Das2014_CodeMixing,
 abstract = {This paper investigates the challenges of automatic language identification in code-mixed social media text (e.g., English-Hindi, English-Bengali). It introduces a hierarchical model combining character and token-level features using CRFs, achieving 90% accuracy. This work lays the groundwork for more nuanced NLP pipelines that can accurately process multilingual social media data.},
 author = {Amitava Das and Björn Gambäck},
 journal = {Traitement Automatique des Langues (TAL)},
 number = {3},
 pages = {41--64},
 title = {Code-Mixing in Social Media Text: The Last Language Identification Frontier?},
 volume = {54},
 year = {2014}
}
