---
layout: page
---
<div class="post">
  <article>
    {% if page.groups %}
      {% for group in page.groups %}
        <h2>{{ group.title }}</h2>
        <hr>
        <div class="profile-group container ">
          <div class="row mx-n4">
            {% for profile in group.members %}
              <div class="team col-md-6 p-2">
                <div class="container">
                  <div class="row {% if profile.align == 'right' %}flex-row-reverse{% endif %}">
                    {% if profile.image %}
                      <div class="col-4 p-1">
                        {% assign profile_image_path = profile.image | prepend: 'assets/img/team/' %}
                        {% if profile.image_circular %}
                          {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
                        {% else %}
                          {% assign profile_image_class = 'img-fluid z-depth-1 rounded' %}
                        {% endif %}
                        {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px) 30vw, 95vw"{% endcapture %}
                        {% include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=profile.image %}
                        {% if profile.more_info %}
                          <div class="more-info">{{ profile.more_info }}</div>
                        {% endif %}
                      </div>
                    {% endif %}
                    <div class="col-8 px-2">
                      {% if profile.content %}
                        {{ profile.content | markdownify }}
                      {% else %}
                        {{ profile.name }}
                      {% endif %}
                    </div>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
        <hr>
      {% endfor %}
    {% endif %}
  </article>
</div>
